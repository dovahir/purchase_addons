<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <!-- =========================== CATEGORÍA DE GRUPOS =========================== -->
    <record id="module_category_purchase_request" model="ir.module.category">
        <field name="name">Solicitudes de Insumos</field>
        <field name="sequence">15</field>
    </record>

    <!-- =========================== GRUPOS DE USUARIOS =========================== -->
    <record id="group_purchase_request_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="category_id" ref="module_category_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Usuario con acceso básico a líneas de solicitud (creación, edición, lectura).</field>
    </record>

    <record id="group_purchase_request_manager" model="res.groups">
        <field name="name">Gestor</field>
        <field name="category_id" ref="module_category_purchase_request"/>
        <field name="implied_ids" eval="[(4, ref('group_purchase_request_user'))]"/>
        <field name="comment">Acceso completo a todas las líneas y asignaciones, sin restricciones.</field>
    </record>

    <!-- =========================== REGLAS PARA LÍNEAS =========================== -->
<!--    <record id="purchase_request_line_company_rule" model="ir.rule">-->
<!--        <field name="name">Líneas multi-compañía</field>-->
<!--        <field name="model_id" ref="model_purchase_request_line"/>-->
<!--        <field name="global" eval="True"/>-->
<!--        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>-->
<!--    </record>-->

    <record id="purchase_request_line_manager_rule" model="ir.rule">
        <field name="name">Líneas: acceso total (manager)</field>
        <field name="model_id" ref="model_purchase_request_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_request_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- =========================== REGLAS PARA ASIGNACIONES =========================== -->
<!--    <record id="purchase_request_allocation_company_rule" model="ir.rule">-->
<!--        <field name="name">Asignaciones multi-compañía</field>-->
<!--        <field name="model_id" ref="model_purchase_request_allocation"/>-->
<!--        <field name="global" eval="True"/>-->
<!--        <field name="domain_force">['|',('company_id','=',False),('company_id','in',company_ids)]</field>-->
<!--    </record>-->

    <record id="purchase_request_allocation_manager_rule" model="ir.rule">
        <field name="name">Asignaciones: acceso total (manager)</field>
        <field name="model_id" ref="model_purchase_request_allocation"/>
        <field name="groups" eval="[(4, ref('group_purchase_request_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[(1,'=',1)]</field>
    </record>

</odoo>