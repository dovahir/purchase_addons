<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_replenish_purchase_request_wizard_form" model="ir.ui.view">
        <field name="name">replenish.purchase.request.wizard.form</field>
        <field name="model">replenish.purchase.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Agregar productos de reabastecimiento a solicitud de insumos">
                <!-- sheet eliminado -->
                <group>
                    <field name="purchase_request_id"
                           options="{'no_create': True}"
                           placeholder="Seleccione una solicitud de insumos activa"
                           domain="[('state', '=', 'draft')]"
                           required="1"/>
                </group>
                <field name="line_ids" nolabel="1" mode="tree">
                    <tree editable="bottom" create="false" delete="false">
                        <!-- open_form="false" eliminado -->
                        <field name="product_id" readonly="1" options="{'no_create': True}"/>
                        <field name="product_qty" string="Cantidad" decoration-bf="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="note" placeholder="Notas opcionales"/>
                    </tree>
                </field>
                <footer>
                    <button name="add_to_request" string="Agregar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>