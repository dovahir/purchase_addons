<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_send_email_wizard_form" model="ir.ui.view">
        <field name="name">purchase.request.send.email.wizard.form</field>
        <field name="model">purchase.request.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar cotización por correo">
                <group>
                    <field name="partner_id"
                           required="1"
                           options="{'no_create': True}"
                           placeholder="Seleccione un proveedor"/>
                    <field name="subject" placeholder="Asunto del correo"/>
                </group>
                <field name="line_ids" nolabel="1" mode="tree">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="product_id" readonly="1"/>
                        <field name="product_qty" string="Cantidad" decoration-bf="1"/>
                        <field name="uom_id" readonly="1"/>
                        <field name="note" readonly="1" optional="hide"/>
                        <field name="request_line_id" column_invisible="1"/>
                    </tree>
                </field>
                <field name="email_body" placeholder="Cuerpo del mensaje"/>
                <footer>
                    <button name="action_send_email" string="Enviar correo" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>