<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Definición del reporte PDF -->
    <record id="report_purchase_request_email_pdf" model="ir.actions.report">
        <field name="name">Cotización por correo</field>
        <field name="model">purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">purchase_addons.report_purchase_request_email_content</field>
        <field name="report_file">purchase_addons.report_purchase_request_email_content</field>
        <field name="print_report_name">'Cotizacion_%s_%s' % (object.name or '', fields.Datetime.now().strftime('%Y%m%d'))</field>
    </record>

    <!-- Plantilla QWeb del reporte -->
    <template id="report_purchase_request_email_content">
        <t t-call="web.html_container">
            <div class="page">
                <div class="oe_structure"/>
                <h2>Cotización de Productos</h2>

                <!-- Datos de cabecera -->
                <div class="row mt32 mb32">
                    <div class="col-auto">
                        <strong>Solicitud:</strong>
                        <br/>
                        <span t-field="object.name"/>
                    </div>
                    <div class="col-auto">
                        <strong>Fecha:</strong>
                        <br/>
                        <span t-field="object.create_date"/>
                    </div>
                    <div class="col-auto">
                        <strong>Empresa:</strong>
                        <br/>
                        <span t-field="object.company_id.name"/>
                    </div>
                    <div class="col-auto">
                        <strong>Proveedor:</strong>
                        <br/>
                        <span t-esc="partner_name"/>
                    </div>
                </div>

                <!-- Tabla de productos seleccionados -->
                <h3>Productos</h3>
                <table class="table table-condensed">
                    <thead>
                        <tr>
                            <th><strong>Producto</strong></th>
                            <th><strong>Especificaciones</strong></th>
                            <th class="text-right"><strong>Cantidad</strong></th>
                            <th class="text-center"><strong>UoM</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Usar la variable 'selected_lines' directamente -->
                        <tr t-foreach="selected_lines" t-as="line">
                            <td><span t-field="line.product_id.display_name"/></td>
                            <td><span t-field="line.note"/></td>
                            <td class="text-right"><span t-field="line.product_qty"/></td>
                            <td class="text-center"><span t-field="line.product_uom_id.name"/></td>
                        </tr>
                        <tr t-if="not selected_lines">
                            <td colspan="4" class="text-center text-muted">
                                No hay productos seleccionados.
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
</odoo>