    <!-- =========================== SUB-VISTAS PARA PO LINES =========================== -->
    <record id="purchase_order_line_form_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.form.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Compra" create="false" readonly="1">
                <sheet>
                    <h1>
                        <field name="order_id" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
<!--                            <field name="product_uom_category_id" invisible="1"/>-->
                            <field name="product_uom" groups="uom.group_uom" readonly="1"/>
                            <field name="price_unit" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_planned" widget="date" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting" readonly="1"/>
                        </group>
                    </group>
                    <field name="name" readonly="1"/>
                    <!-- Campo many2many que existe en nuestro modelo extendido -->
                    <field name="purchase_request_lines" widget="many2many_tags" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_order_line_tree_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree name="Líneas de Compra" create="false">
                <field name="order_id" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="product_uom" groups="uom.group_uom"/>
<!--                <field name="price_unit" widget="monetary"/>-->
<!--                <field name="price_subtotal" widget="monetary" sum="Total"/>-->
                <field name="date_planned" widget="date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="purchase_order_line_search_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.search.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas de Compra">
                <field name="order_id" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <filter name="hide_cancelled" string="Ocultar canceladas" domain="[('state','!=','cancel')]"/>
            </search>
        </field>
    </record>

</odoo>