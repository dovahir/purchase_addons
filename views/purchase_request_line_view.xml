<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <!-- =========================== VISTA DE ÁRBOL =========================== -->
    <record id="purchase_request_line_tree" model="ir.ui.view">
        <field name="name">purchase.request.line.tree</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <tree name="Líneas de Solicitud" create="false">
                <header>
                    <button name="action_open_send_email_wizard"
                            string="Enviar correo"
                            type="object"
                            icon="fa-envelope"
                            class="btn-primary"/>
                </header>
                <field name="request_id" string="Solicitud" widget="many2one"/>
                <field name="priority" widget="badge" optional="show"
                       decoration-warning="priority == 'urgent'"/>
                <field name="line_state" widget="badge"
                       decoration-muted="line_state == 'cancel'"
                       decoration-info="line_state in ('pending','email_sent','in_progress')"
                       decoration-warning="line_state == 'to_receive'"
                       decoration-success="line_state in ('partially_purchased','purchased')"/>
                <field name="product_id" string="Producto" options="{'no_create': True}" widget="many2one"/>
                <field name="product_qty" string="Cant. Solicitada"/>
                <field name="product_uom_id" string="UoM" groups="uom.group_uom" options="{'no_create': True}"/>
<!--                <field name="supplier_id" string="Proveedor preferido" optional="hide"/>-->
                <field name="requisition_id" string="Requisición" optional="show" widget="many2one"/>
                <field name="project_id" string="Proyecto" optional="show"/>
                <field name="task_id" string="Tarea" optional="show"/>
                <field name="date_required" string="Fecha requerida"/>
                <field name="is_replenishment" string="Reabastecimiento" optional="show" widget="boolean"/>
                <field name="purchase_state" string="Estado de compra" optional="show"
                       widget="badge"
                       decoration-success="purchase_state == 'purchase' or purchase_state == 'done'"
                       decoration-warning="purchase_state == 'to approve'"
                       decoration-info="purchase_state == 'draft' or purchase_state == 'sent'"/>
                <field name="pending_qty_to_buy" string="Pendiente comprar" optional="hide"/>
                <field name="qty_in_progress" string="En proceso" optional="hide"/>
                <field name="qty_done" string="Recibido" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" widget="selection" optional="hide"/>
<!--                <button name="action_show_details" type="object"-->
<!--                        icon="fa-external-link" title="Ver detalle" optional="hide"/>-->
            </tree>
        </field>
    </record>

    <!-- =========================== VISTA DE BÚSQUEDA =========================== -->
    <record id="purchase_request_line_search" model="ir.ui.view">
        <field name="name">purchase.request.line.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas de Solicitud">
                <field name="request_id" string="Solicitud"/>
                <field name="product_id" string="Producto" filter_domain="[('product_id','=',self)]"/>
                <field name="project_id" string="Proyecto"/>
                <field name="task_id" string="Tarea"/>
<!--                <field name="supplier_id" string="Proveedor"/>-->
                <field name="analytic_distribution" groups="analytic.group_analytic_accounting"/>

                <separator/>
                <filter name="state_pending" string="Pendientes" domain="[('line_state','=','pending')]"/>
                <filter name="state_email_sent" string="Cotización enviada" domain="[('line_state','=','email_sent')]"/>
                <filter name="state_in_progress" string="En cotización" domain="[('line_state','=','in_progress')]"/>
                <filter name="state_to_receive" string="Por recepcionar" domain="[('line_state','=','to_receive')]"/>
                <filter name="state_partial" string="Parcialmente comprado" domain="[('line_state','=','partially_purchased')]"/>
                <filter name="state_purchased" string="Comprados" domain="[('line_state','=','purchased')]"/>
                <filter name="state_cancel" string="Cancelados" domain="[('line_state','=','cancel')]"/>
                <separator/>
                <filter name="my_requests" string="Mis solicitudes" domain="[('request_id.purchaser','=',uid)]"/>
                <filter name="qty_to_buy" string="Pendiente de comprar" domain="[('pending_qty_to_buy','>',0)]"/>
                <filter name="all_bought" string="Totalmente comprados" domain="[('pending_qty_to_buy','=',0)]"/>
                <filter name="open_qty" string="Con cantidad en proceso" domain="[('qty_in_progress','>',0)]"/>
                <filter name="urgent" string="Urgentes" domain="[('priority','=','urgent')]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_request" string="Solicitud" context="{'group_by':'request_id'}"/>
                    <filter name="group_product" string="Producto" context="{'group_by':'product_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by':'line_state'}"/>
                    <filter name="group_project" string="Proyecto" context="{'group_by':'project_id'}"/>
                    <filter name="group_priority" string="Prioridad" context="{'group_by':'priority'}"/>
<!--                    <filter name="group_supplier" string="Proveedor" context="{'group_by':'supplier_id'}"/>-->
                    <filter name="group_purchase_state" string="Estado de compra" context="{'group_by':'purchase_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =========================== VISTA DE FORMULARIO =========================== -->
    <record id="purchase_request_line_form" model="ir.ui.view">
        <field name="name">purchase.request.line.form</field>
        <field name="model">purchase.request.line</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Línea de Solicitud" create="false" duplicate="false">
                <header>
                        <button name="action_cancel_line"
                                type="object"
                                string="Cancelar línea"
                                class="btn-danger"
                                invisible="line_state in ('cancel','purchased')"
                                confirm="¿Está seguro de cancelar esta línea? Esta acción puede afectar órdenes de compra asociadas."/>
                    <field name="line_state" widget="statusbar"
                           statusbar_visible="pending,email_sent,in_progress,to_receive,partially_purchased,purchased,cancel"
                           readonly="1"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_request" type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                string="Solicitud">
                            <div class="o_stat_info">
                                <field name="request_id" widget="statinfo" string="Solicitud"/>
                            </div>
                        </button>
                        <button name="action_open_purchase_orders" type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not purchase_lines">
                            <div class="o_stat_info">
                                <field name="purchase_lines" widget="statinfo" string="Cotizaciones"/>
                            </div>
                        </button>
                        <button name="action_open_pickings" type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not purchase_request_allocation_ids"
                                groups="stock.group_stock_manager">
                            <div class="o_stat_info">
                                <field name="purchase_request_allocation_ids" widget="statinfo" string="Recepciones"/>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Descripción del producto" readonly="1"/>
                        </h1>
                    </div>

                    <group name="main">
                        <group name="settings">
                            <field name="product_id" readonly="line_state != 'draft'"/>
                            <field name="product_qty" readonly="line_state != 'draft'"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                            <field name="date_required" readonly="line_state != 'draft'"/>
<!--                            <field name="supplier_id" readonly="1"/>-->
                            <field name="priority" widget="badge" readonly="line_state != 'draft'"/>
                            <field name="is_replenishment" widget="boolean" readonly="1"/>
                            <field name="requisition_id" readonly="1"
                                   invisible="not requisition_id"
                                   help="Requisición origen"/>
                            <field name="note" readonly="line_state != 'draft'"/>
                        </group>
                        <group name="info">
                            <field name="request_id" readonly="1"/>
<!--                            <field name="origin" readonly="1"/>-->
                            <field name="company_id" groups="base.group_multi_company" widget="selection" readonly="1"/>
                        </group>
                    </group>

                    <group name="project_group" string="Proyecto / Tarea">
                        <field name="project_id" readonly="line_state != 'draft'"/>
                        <field name="task_id" readonly="line_state != 'draft'" options="{'no_create': True}"/>
                        <field name="analytic_distribution" widget="analytic_distribution"
                               groups="analytic.group_analytic_accounting"
                               readonly="line_state != 'draft'"
                               options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"/>
                    </group>

                    <group name="quantities" string="Seguimiento de cantidades">
                        <group>
                            <field name="pending_qty_to_buy" string="Pendiente por comprar"/>
                            <field name="qty_in_progress" string="En proceso"/>
                            <field name="qty_done" string="Recibido"/>
                            <field name="qty_cancelled" string="Cancelado"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="purchase_lines" string="Órdenes de Compra">
                            <group>
                                <field name="purchase_state"
                                       widget="badge"
                                       decoration-success="purchase_state == 'purchase' or purchase_state == 'done'"
                                       decoration-warning="purchase_state == 'to approve'"
                                       decoration-info="purchase_state == 'draft' or purchase_state == 'sent'"/>
                            </group>
                            <field name="purchase_lines" nolabel="1"
                                   domain="[('product_id', '=', product_id)]"
                                   context="{'form_view_ref': 'purchase_addons.purchase_order_line_form_sub',
                                            'tree_view_ref': 'purchase_addons.purchase_order_line_tree_sub',
                                            'search_view_ref': 'purchase_addons.purchase_order_line_search_sub'}"/>
                        </page>

                        <page name="email_logs" string="Envíos de cotización">
                            <field name="email_log_ids" nolabel="1">
                                <tree>
                                    <field name="date_sent"/>
                                    <field name="partner_id"/>
                                    <field name="email_to"/>
                                    <field name="subject"/>
                                </tree>
                            </field>
                        </page>
                        <page name="allocations" string="Asignaciones">
                            <field name="purchase_request_allocation_ids" nolabel="1">
                                <tree decoration-muted="purchase_state == 'cancel'">
                                    <field name="stock_move_id" string="Movimiento"/>
                                    <field name="purchase_line_id" string="Línea de compra"/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="requested_product_uom_qty" string="Solicitado"/>
                                    <field name="allocated_product_qty" string="Asignado"/>
                                    <field name="open_product_qty" string="Pendiente"/>
                                    <field name="product_uom_id" string="UoM"/>
                                    <field name="purchase_state" string="Estado compra" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

