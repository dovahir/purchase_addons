<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <!-- =========================== VISTA DE ÁRBOL =========================== -->
    <record id="purchase_request_line_tree" model="ir.ui.view">
        <field name="name">purchase.request.line.tree</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <tree name="Líneas de Solicitud" create="false">
                <header>
<!--                    <button name="action_open_send_email_wizard"-->
<!--                            string="Enviar correo"-->
<!--                            type="object"-->
<!--                            icon="fa-envelope"-->
<!--                            class="btn-primary"/>-->
                    <button name="action_open_add_to_rfq_wizard"
                            string="Añadir a RFQ"
                            type="object"
                            icon="fa-shopping-cart"
                            groups="purchase.group_purchase_manager"
                            class="btn-primary"/>
                    <button name="action_cancel_multiple"
                            string="Cancelar seleccionadas"
                            type="object"
                            icon="fa-times"
                            class="btn-danger"
                            groups="purchase.group_purchase_manager"
                            confirm="¿Está seguro de cancelar las líneas seleccionadas? Esta acción puede afectar órdenes de compra asociadas."/>
                </header>
                <field name="product_uom_category_id" column_invisible="1"/>
                <field name="priority" widget="priority" optional="show" nolabel="1"/>
                <field name="product_id" string="Producto" options="{'no_create': True}" widget="many2one"/>
                <field name="note"/>
                <field name="product_qty" string="Cant. Solicitada"/>
                <field name="pending_qty_to_buy" string="Pendiente comprar" optional="hide"/>
                <field name="qty_in_progress" string="En proceso" optional="hide"/>
                <field name="qty_done" string="Recibido" optional="hide"/>
                <field name="qty_cancelled" string="Cancelado" optional="hide"/>
                <field name="product_uom_id" string="UoM" groups="uom.group_uom" options="{'no_create': True}"/>
                <field name="requester_name" string="Solicita" optional="show"/>
                <field name="requisition_id" string="Requisición" optional="show" widget="many2one"/>
                <field name="analytic_distribution" optional="show"
                       string="Dist. Analítica"
                       widget="analytic_distribution"
                       groups="analytic.group_analytic_accounting"
                       options="{'product_field': 'product_id', 'business_domain': 'req'}"/>
                <field name="project_id" string="Proyecto" optional="show"/>
                <field name="task_id" string="Tarea" optional="show"/>
                <field name="create_date" string="Fecha solicitada" help="Fecha que se creó la línea"/>
                <field name="date_required" string="Fecha requerida"/>
                <field name="is_replenishment" string="Reabastecimiento" optional="hide" widget="boolean"/>
                <field name="purchase_lines" column_invisible="1"/>
                <button name="action_open_purchase_orders" string="Ver RFQs"
                        type="object"
                        title="Ver RFQs"
                        class="btn-primary"
                        invisible="not purchase_lines"/>
                <field name="line_state" widget="badge"
                       decoration-muted="line_state == 'pending'"
                       decoration-info="line_state in ('email_sent','in_progress')"
                       decoration-primary="line_state == 'to_receive'"
                       decoration-success="line_state in ('partially_purchased','purchased')"
                       decoration-danger="line_state == 'cancel'"/>
                <field name="purchase_state" string="Estado de compra" optional="hide"
                       widget="badge"
                       decoration-success="purchase_state == 'purchase' or purchase_state == 'done'"
                       decoration-warning="purchase_state == 'to approve'"
                       decoration-info="purchase_state == 'draft' or purchase_state == 'sent'"/>
                <button name="action_cancel_line"
                        type="object"
                        icon="fa-times-circle"
                        class="text-danger"
                        title="Cancelar línea"
                        invisible="line_state in ('cancel','purchased')"
                        groups="purchase.group_purchase_manager"
                        confirm="¿Está seguro de cancelar esta línea?"/>
            </tree>
        </field>
    </record>

    <!-- =========================== VISTA DE BÚSQUEDA =========================== -->
    <record id="purchase_request_line_search" model="ir.ui.view">
        <field name="name">purchase.request.line.search</field>
        <field name="model">purchase.request.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas de Solicitud">
                <field name="product_id" string="Producto" filter_domain="[('product_id','=',self)]"/>
                <field name="project_id" string="Proyecto"/>
                <field name="task_id" string="Tarea"/>
                <field name="requisition_id" string="Requisición"/>
                <field name="purchase_order_ids" string="Orden de compra"/>
                <field name="analytic_distribution" groups="analytic.group_analytic_accounting"/>

                <separator/>
                <filter name="all_pending" string="Pendientes" domain="[('line_state', 'not in', ['purchased', 'cancel'])]"/>
<!--                <filter name="state_pending" string="Pendientes" domain="[('line_state','=','pending')]"/>-->
                <filter name="state_email_sent" string="Cotización enviada" domain="[('line_state','=','email_sent')]"/>
                <filter name="state_in_progress" string="En cotización" domain="[('line_state','=','in_progress')]"/>
                <filter name="state_to_receive" string="Por recepcionar" domain="[('line_state','=','to_receive')]"/>
                <filter name="state_partial" string="Parcialmente comprado" domain="[('line_state','=','partially_purchased')]"/>
                <filter name="state_purchased" string="Comprados" domain="[('line_state','=','purchased')]"/>
                <filter name="state_cancel" string="Cancelados" domain="[('line_state','=','cancel')]"/>
                <separator/>
                <filter name="qty_to_buy" string="Pendiente de comprar" domain="[('pending_qty_to_buy','>',0)]"/>
                <filter name="all_bought" string="Totalmente comprados" domain="[('pending_qty_to_buy','=',0)]"/>
                <filter name="open_qty" string="Con cantidad en proceso" domain="[('qty_in_progress','>',0)]"/>
                <filter name="urgent" string="Urgentes" domain="[('priority','=','urgent')]"/>
                <separator/>
                <filter string="Archivado" name="archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_product" string="Producto" context="{'group_by':'product_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by':'line_state'}"/>
                    <filter name="group_project" string="Proyecto" context="{'group_by':'project_id'}"/>
                    <filter name="group_priority" string="Prioridad" context="{'group_by':'priority'}"/>
                    <filter name="group_requisition" string="Requisición" context="{'group_by':'requisition_id'}"/>
                    <filter name="group_purchase_state" string="Estado de compra" context="{'group_by':'purchase_state'}"/>
                    <filter name="group_replenishment" string="Reabastecimiento" context="{'group_by':'is_replenishment'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- =========================== VISTA DE FORMULARIO =========================== -->
    <record id="purchase_request_line_form" model="ir.ui.view">
        <field name="name">purchase.request.line.form</field>
        <field name="model">purchase.request.line</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Línea de Solicitud" create="false" duplicate="false">
                <header>
                    <button name="action_open_add_to_rfq_wizard"
                            string="Añadir a RFQ"
                            type="object"
                            class="btn-primary"
                            icon="fa-shopping-cart"
                            groups="purchase.group_purchase_manager"
                            invisible="line_state in ('cancel', 'purchased')"/>
                    <button name="action_cancel_line"
                            type="object"
                            string="Cancelar línea"
                            class="btn-danger"
                            invisible="line_state in ('cancel','purchased')"
                            groups="purchase.group_purchase_manager"
                            confirm="¿Está seguro de cancelar esta línea? Esta acción puede afectar órdenes de compra asociadas."/>
                    <field name="line_state" widget="statusbar"
                           statusbar_visible="pending,email_sent,in_progress,to_receive,partially_purchased,purchased"
                           readonly="1"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_purchase_orders" type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="not purchase_lines">
                            <div class="o_stat_info">
                                <field name="purchase_lines" widget="statinfo" string="Cotizaciones"/>
                            </div>
                        </button>
                        <button name="action_open_pickings" type="object"
                                class="oe_stat_button"
                                icon="fa-truck"
                                invisible="picking_count == 0"
                                groups="stock.group_stock_manager">
                            <div class="o_stat_info">
                                <field name="picking_count" widget="statinfo" string="Recepciones"/>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Descripción del producto" readonly="1"/>
                        </h1>
                    </div>

                    <group name="main">
                        <group name="details" string="">
                            <field name="product_id" readonly="line_state != 'draft'"/>
                            <field name="note" readonly="line_state != 'draft'"/>
                            <field name="create_date" string="Fecha solicitada"
                                   readonly="1" help="Fecha en que se solicitó comprar"/>
                            <field name="date_required" readonly="line_state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="line_state in ('purchased', 'cancel')"/>
                            <field name="requester_name" readonly="1" string="Solicitado por" placeholder="Nombre de quien solicita"/>
                        </group>
                        <group name="quantities" string="">
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom_id" groups="uom.group_uom" readonly="1"/>
                            <field name="product_qty" readonly="line_state != 'draft'"/>
                            <field name="pending_qty_to_buy" string="Pendiente por comprar"/>
                            <field name="qty_in_progress" string="En proceso"/>
                            <field name="qty_done" string="Recibido"/>
                            <field name="qty_cancelled" string="Cancelado"/>
                        </group>
                    </group>

                    <group name="origin_group" string="Origen">
                        <field name="is_replenishment" widget="boolean" readonly="1" invisible="requisition_id"/>
                        <field name="requisition_id" readonly="1"
                               invisible="not requisition_id"
                               help="Requisición origen"/>
                        <field name="project_id" readonly="line_state != 'draft'" invisible="is_replenishment"/>
                        <field name="task_id" readonly="line_state != 'draft'" options="{'no_create': True}" invisible="is_replenishment"/>
                        <field name="analytic_distribution" widget="analytic_distribution" invisible="is_replenishment"
                               groups="analytic.group_analytic_accounting"
                               readonly="line_state != 'draft'"
                               options="{'product_field': 'product_id', 'business_domain': 'purchase_order'}"/>
                    </group>

                    <notebook>
                        <page name="purchase_lines" string="Órdenes de Compra">
                            <group>
                                <field name="purchase_state"
                                       widget="badge"
                                       decoration-success="purchase_state == 'purchase' or purchase_state == 'done'"
                                       decoration-warning="purchase_state == 'to approve'"
                                       decoration-info="purchase_state == 'draft' or purchase_state == 'sent'"/>
                            </group>
                            <field name="purchase_lines" nolabel="1"
                                   domain="[('product_id', '=', product_id)]"
                                   context="{'form_view_ref': 'purchase_addons.purchase_order_line_form_sub',
                                            'tree_view_ref': 'purchase_addons.purchase_order_line_tree_sub',
                                            'search_view_ref': 'purchase_addons.purchase_order_line_search_sub'}"/>
                        </page>

                        <page name="email_logs" string="Envíos de cotización">
                            <field name="email_log_ids" nolabel="1">
                                <tree>
                                    <field name="date_sent"/>
                                    <field name="partner_id"/>
                                    <field name="email_to"/>
                                    <field name="subject"/>
                                </tree>
                            </field>
                        </page>

                        <page name="allocations" string="Asignaciones" invisible="1">
                            <field name="purchase_request_allocation_ids" nolabel="1">
                                <tree decoration-muted="purchase_state == 'cancel'">
                                    <field name="stock_move_id" string="Movimiento"/>
                                    <field name="purchase_line_id" string="Línea de compra"/>
                                    <field name="product_id" string="Producto"/>
                                    <field name="requested_product_uom_qty" string="Solicitado"/>
                                    <field name="allocated_product_qty" string="Asignado"/>
                                    <field name="open_product_qty" string="Pendiente"/>
                                    <field name="product_uom_id" string="UoM"/>
                                    <field name="purchase_state" string="Estado compra" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- =========================== ACCIONES =========================== -->
    <record id="purchase_request_line_form_action" model="ir.actions.act_window">
        <field name="name">Líneas de Solicitud</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="purchase_request_line_tree"/>
        <field name="search_view_id" ref="purchase_request_line_search"/>
        <field name="context">{'search_default_all_pending': 1}</field>
        <field name="help" type="html">
            <p>
                Las solicitudes representan productos individuales
                que pueden tener su origen en requisiciones de empleados o reabastecimiento.
                Desde aquí puede ver el estado de cada producto, las órdenes de compra
                y recepciones asociadas.
            </p>
        </field>
    </record>

    <!-- Acción desde producto (binding) -->
    <record id="action_purchase_request_line_product_tree" model="ir.actions.act_window">
        <field name="name">Solicitudes de Insumos</field>
        <field name="res_model">purchase.request.line</field>
        <field name="view_mode">tree,form</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="context">{'search_default_product_id': active_id}</field>
    </record>

    <!-- =========================== SUB-VISTAS PARA PO LINES =========================== -->
    <record id="purchase_order_line_form_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.form.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <form string="Línea de Compra" create="false" readonly="1">
                <sheet>
                    <h1>
                        <field name="order_id" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                            <field name="product_uom" groups="uom.group_uom" readonly="1"/>
                            <field name="price_unit" widget="monetary" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_planned" widget="date" readonly="1"/>
<!--                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>-->
                            <field name="analytic_distribution" widget="analytic_distribution"
                                   groups="analytic.group_analytic_accounting" readonly="1"/>
                        </group>
                    </group>
                    <field name="name" readonly="1"/>
                    <field name="purchase_request_lines" widget="many2many_tags" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_order_line_tree_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.tree.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <tree name="Líneas de Compra" create="false">
                <field name="order_id" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="product_uom" groups="uom.group_uom"/>
                <field name="date_planned" widget="date"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="purchase_order_line_search_sub" model="ir.ui.view">
        <field name="name">purchase.order.line.search.sub</field>
        <field name="model">purchase.order.line</field>
        <field name="arch" type="xml">
            <search string="Buscar Líneas de Compra">
                <field name="order_id" string="Orden"/>
                <field name="product_id" string="Producto"/>
                <filter name="hide_cancelled" string="Ocultar canceladas" domain="[('state','!=','cancel')]"/>
            </search>
        </field>
    </record>

</odoo>